# Required by the Vercel functions and the local Vite API middleware.
# Copy this file to .env.local and insert the connection string from Neon.
# Never commit a real credential.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional: rate-limit bucket hashing salt. Use a long random value in production.
# If omitted, rate-limit keys are still SHA-256 hashed but are not additionally salted.
FANA_RATE_LIMIT_SALT=
